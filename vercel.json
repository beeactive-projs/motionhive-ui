{
  "routes": [
    {
      "src": "^/(?:ro/)?(?:(?:main|polyfills|styles|chunk)-[A-Za-z0-9_-]+\\.(?:js|css)|media/.+)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/videos/.+$",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" },
      "continue": true
    },
    {
      "src": "^/en/?$",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/en/(.*)$",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    { "handle": "filesystem" },
    {
      "src": "^/blog/sitemap\\.xml$",
      "dest": "https://motionhive-api-production.up.railway.app/blog/sitemap.xml"
    },
    {
      "src": "^/ro/blog/[^/]+/?$",
      "status": 404,
      "dest": "/ro/index.csr.html"
    },
    {
      "src": "^/blog/[^/]+/?$",
      "status": 404,
      "dest": "/index.csr.html"
    },
    {
      "src": "^/ro(/.*)?$",
      "dest": "/ro/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
