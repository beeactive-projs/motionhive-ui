{
  "buildCommand": "ng build core && ng build website --configuration production && node scripts/patch-ro-index.mjs",
  "outputDirectory": "dist/website/browser",
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ro/:path*",
      "destination": "/ro/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}