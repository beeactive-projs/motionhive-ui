{
  "routes": [
    {
      "src": "^/en/?$",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/en/(.*)$",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    { "handle": "filesystem" },
    {
      "src": "^/blog/sitemap\\.xml$",
      "dest": "https://motionhive-api-production.up.railway.app/blog/sitemap.xml"
    },
    {
      "src": "^/ro/blog/[^/]+/?$",
      "status": 404,
      "dest": "/ro/index.csr.html"
    },
    {
      "src": "^/blog/[^/]+/?$",
      "status": 404,
      "dest": "/index.csr.html"
    },
    {
      "src": "^/ro(/.*)?$",
      "dest": "/ro/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
