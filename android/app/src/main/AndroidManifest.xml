<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: web app URLs from emails open here instead of the
                 browser. The host is per build (appLinkHost in app/build.gradle);
                 the domain proves the claim with /.well-known/assetlinks.json
                 (projects/web/public). Only paths the app has a screen for:
                 group invites (/join) and public profiles (/@) stay on the web.
                 The app maps them in _shared/config/app-link.config.ts.
                 iOS claims the same paths in apple-app-site-association
                 (projects/web/public/.well-known); change both together. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
                <data android:pathPrefix="/auth/login" />
                <data android:pathPrefix="/auth/signup" />
                <data android:pathPrefix="/auth/reset-password" />
                <data android:pathPrefix="/auth/new-password" />
                <data android:pathPrefix="/auth/verify-email" />
                <data android:pathPrefix="/messages" />
                <data android:pathPrefix="/coaching/sessions" />
                <data android:pathPrefix="/coaching/clients" />
                <data android:pathPrefix="/coaching/pending-requests" />
                <data android:pathPrefix="/coaching/invoices" />
                <data android:pathPrefix="/coaching/payments" />
                <data android:pathPrefix="/sessions" />
                <data android:pathPrefix="/user/sessions" />
                <data android:pathPrefix="/groups" />
                <data android:pathPrefix="/profile" />
                <!-- Shared from the app: a profile (/@handle) and a group's invite link. -->
                <data android:pathPrefix="/@" />
                <data android:pathPrefix="/join/" />
            </intent-filter>

        </activity>

        <!-- Small icon and accent for every push. The server names no icon, so
             these apply; without them Android masks the launcher icon into a
             white blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_motionhive" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mh_notification_accent" />

        <!-- Facebook sign-in (FacebookSignInService). The ids are in
             res/values/strings.xml; the client token is meant to be in the
             app, it is not the App Secret. Event logging and advertising id
             collection are off, so the SDK sends no app events and reads no
             advertising id. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <!-- Where Facebook's login in a browser tab comes back to the app
             (fb + the app id). The SDK declares the activity itself; this
             adds the app's own scheme, as Meta's setup asks. -->
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>

        <!-- The buttons on the workout's ongoing notification (RestLive.java). -->
        <receiver
            android:name=".RestLiveReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Facebook's SDK asks for the advertising id, the Privacy Sandbox ad
         APIs and the Play install referrer. It uses them only to measure ads
         and attribute app events, never to log in, and the app does neither
         (collection is off above), so they are taken out of the merged
         manifest and Play's advertising id answer stays "no". -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />
    <!-- Save to Photos on Android 9 and older. From 10 the gallery takes a
         new picture through MediaStore with no permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (Android 11+): without these the app cannot see
         that Instagram is installed, so Quick share would always fall back
         to the share sheet and Open Instagram would open the website. -->
    <queries>
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="com.instagram.share.ADD_TO_STORY" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
</manifest>
