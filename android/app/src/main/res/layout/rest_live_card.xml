<?xml version="1.0" encoding="utf-8"?>
<!-- The workout's ongoing notification unfolded, in the Hex meter design
     (RestLive.java): the ring on the left with the time inside it, the
     kicker, the next set and its target beside it. Android draws its own
     header above it and the buttons below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/rest_card_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/rest_card_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- The clock and its caption live inside the ring, so they are
                 sized in dp, as iOS fixes them, and shrink to fit the ring's
                 clear width rather than spill onto it: "1:05:12" past an
                 hour, the Romanian "Antrenament". maxLines, not singleLine,
                 which turns autosizing off. -->
            <Chronometer
                android:id="@+id/rest_card_clock"
                android:layout_width="50dp"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="17dp"
                android:autoSizeMinTextSize="11dp"
                android:autoSizeStepGranularity="1dp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="17dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rest_card_caption"
                android:layout_width="50dp"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11dp"
                android:autoSizeMinTextSize="8dp"
                android:autoSizeStepGranularity="0.5dp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Compat.Notification"
                android:textSize="11dp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rest_card_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Compat.Notification"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/rest_card_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Compat.Notification"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/rest_card_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_card_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
